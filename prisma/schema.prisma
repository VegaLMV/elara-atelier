generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  COLABORADOR
}

enum EstadoProducto {
  ACTIVO
  INACTIVO
}

enum EstadoCompra {
  BORRADOR
  ORDENADO
  RECIBIDO
  CANCELADO
}

enum TipoMovimientoInventario {
  COMPRA
  VENTA
  AJUSTE
  DEVOLUCION
}

enum TipoDescuentoProducto {
  PORCENTAJE
  MONTO
}

enum EstadoDescuentoProducto {
  PROGRAMADO
  ACTIVO
  FINALIZADO
  CANCELADO
}

enum MetodoPago {
  YAPE
  PLIN
  EFECTIVO
  TRANSFERENCIA
}

model Usuario {
  id       String   @id @default(cuid())
  correo   String   @unique
  clave    String
  rol      Rol      @default(COLABORADOR)
  creadoEn DateTime @default(now())

  descuentosCreados DescuentoProducto[] @relation("DescuentoCreadoPor")
}

model Categoria {
  id        String     @id @default(cuid())
  nombre    String
  slug      String     @unique
  productos Producto[]
}

model Producto {
  id          String         @id @default(cuid())
  nombre      String
  slug        String         @unique
  descripcion String?
  precio      Decimal        @db.Decimal(10, 2)
  estado      EstadoProducto @default(ACTIVO)
  destacado   Boolean        @default(false)

  // --- DESCUENTOS ---
  descuentoActivo Boolean                @default(false)
  descuentoTipo   TipoDescuentoProducto?
  descuentoValor  Decimal?               @db.Decimal(10, 2)
  descuentoInicio DateTime?
  descuentoFin    DateTime?

  descuentos DescuentoProducto[] @relation("ProductoDescuentos")

  descuentoActualId String?
  descuentoActual   DescuentoProducto? @relation("ProductoDescuentoActual", fields: [descuentoActualId], references: [id])

  // --- RELACIONES ---
  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  imagenes      ImagenProducto[]
  variantes     Variante[]
  imagenesColor ImagenProductoColor[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model DescuentoProducto {
  id String @id @default(cuid())

  productoId String
  producto   Producto @relation("ProductoDescuentos", fields: [productoId], references: [id], onDelete: Cascade)

  // Relación inversa necesaria para "descuentoActual" en Producto
  productosQueLoUsanComoActual Producto[] @relation("ProductoDescuentoActual")

  nombreCampana String?
  descripcion   String?

  tipo  TipoDescuentoProducto
  valor Decimal               @db.Decimal(10, 2)

  startsAt DateTime
  endsAt   DateTime

  estado EstadoDescuentoProducto @default(PROGRAMADO)

  creadoPorId String?
  creadoPor   Usuario? @relation("DescuentoCreadoPor", fields: [creadoPorId], references: [id])

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([productoId, estado, startsAt, endsAt])
  @@index([startsAt, endsAt])
}

model ImagenProducto {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  url       String
  esPortada Boolean @default(false)
  orden     Int     @default(0)
}

model ImagenProductoColor {
  id String @id @default(cuid())

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  colorId String
  color   Color  @relation(fields: [colorId], references: [id])

  url           String
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([productoId, colorId])
}

model Talla {
  id        String     @id @default(cuid())
  nombre    String     @unique
  orden     Int        @default(0)
  variantes Variante[]
}

model Color {
  id        String     @id @default(cuid())
  nombre    String     @unique
  hex       String?
  variantes Variante[]

  imagenesProducto ImagenProductoColor[]
}

model Variante {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  tallaId String
  talla   Talla  @relation(fields: [tallaId], references: [id])

  colorId String
  color   Color  @relation(fields: [colorId], references: [id])

  sku    String? @unique
  activa Boolean @default(true)

  stockActual Int @default(0)
  stockMinimo Int @default(4)

  movimientos MovimientoInventario[]
  itemsCompra ItemCompra[]
  itemsVenta  ItemVenta[]

  @@unique([productoId, tallaId, colorId])
}

model MovimientoInventario {
  id         String   @id @default(cuid())
  varianteId String
  variante   Variante @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  tipo           TipoMovimientoInventario
  cambioCantidad Int
  costoUnitario  Decimal?                 @db.Decimal(10, 2)
  nota           String?

  compraId String?
  ventaId  String?

  creadoEn DateTime @default(now())
}

model Proveedor {
  id        String  @id @default(cuid())
  nombre    String
  telefono  String?
  correo    String?
  ruc       String?
  direccion String?
  ciudad    String?
  provincia String?

  compras Compra[]
}

model Compra {
  id          String     @id @default(cuid())
  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  estado      EstadoCompra @default(BORRADOR)
  fechaCompra DateTime     @default(now())

  costoEnvio  Decimal? @db.Decimal(10, 2)
  otrosCostos Decimal? @db.Decimal(10, 2)
  notas       String?

  items    ItemCompra[]
  creadoEn DateTime     @default(now())
}

model ItemCompra {
  id       String @id @default(cuid())
  compraId String
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  varianteId String?
  variante   Variante? @relation(fields: [varianteId], references: [id])

  tipoEmpaqueId String?
  tipoEmpaque   TipoEmpaque? @relation(fields: [tipoEmpaqueId], references: [id])

  cantidad      Int
  costoUnitario Decimal @db.Decimal(10, 2)
}

model Venta {
  id            String   @id @default(cuid())
  canal         String   @default("WhatsApp")
  clienteNombre String?
  notas         String?
  fechaVenta    DateTime @default(now())
  metodoPago MetodoPago @default(YAPE)

  items    ItemVenta[]
  empaques UsoEmpaque[]
  creadoEn DateTime     @default(now())
}

model ItemVenta {
  id      String @id @default(cuid())
  ventaId String
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  varianteId String
  variante   Variante @relation(fields: [varianteId], references: [id])

  cantidad Int
}

model TipoEmpaque {
  id            String  @id @default(cuid())
  nombre        String  @unique
  costoUnitario Decimal @db.Decimal(10, 2)
  activo        Boolean @default(true)
  imagenUrl     String?
  stock         Int     @default(0)

  usos UsoEmpaque[]
  itemsCompra ItemCompra[]
}

model UsoEmpaque {
  id      String @id @default(cuid())
  ventaId String
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  tipoEmpaqueId String
  tipoEmpaque   TipoEmpaque @relation(fields: [tipoEmpaqueId], references: [id])

  cantidad   Int
  costoTotal Decimal  @db.Decimal(10, 2)
  creadoEn   DateTime @default(now())
}
