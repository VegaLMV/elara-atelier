generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---
enum Rol {
  ADMIN
  COLABORADOR
}

enum EstadoProducto {
  ACTIVO
  INACTIVO
}

enum EstadoCompra {
  BORRADOR
  ORDENADO
  RECIBIDO
  CANCELADO
}

enum TipoMovimientoInventario {
  COMPRA
  VENTA
  AJUSTE
  DEVOLUCION
}

enum TipoDescuentoProducto {
  PORCENTAJE
  MONTO
}

enum EstadoDescuentoProducto { // Usado por Campana
  PROGRAMADO
  ACTIVO
  FINALIZADO
  CANCELADO
}

enum MetodoPago {
  YAPE
  PLIN
  EFECTIVO
  TRANSFERENCIA
}

enum EstadoVenta {
  PENDIENTE
  COMPLETADO
  ANULADO
}

enum TipoDevolucion {
  CLIENTE
  PROVEEDOR
}

enum AccionDevolucion {
  CAMBIO          // Se lleva otra prenda
  SALDO_A_FAVOR   // Crédito para el futuro
  REEMBOLSO       // Se le devuelve el dinero (solo fallas)
}

enum TipoSeccionHome {
  HERO
  BEST_SELLERS
  FEATURED_COLLECTIONS
  STORY
  NEWSLETTER
  CONTACT
  BENEFITS
  FEATURED_CATEGORIES
  BRAND_ESSENCE
  PROMO_CAMPAIGN
}

enum UbicacionNavegacion {
  HEADER
  FOOTER
}


// --- MODELOS ---

model Usuario {
  id        String   @id @default(cuid())
  correo    String   @unique
  clave     String
  rol       Rol      @default(COLABORADOR)
  creadoEn  DateTime @default(now())

  campanasCreadas Campana[] @relation("CampanaCreadaPor")
}

model Categoria {
  id        String             @id @default(cuid())
  nombre    String
  slug      String             @unique
  visible   Boolean            @default(false)
  orden     Int                @default(0)
  imagenes  ImagenCategoria[]
  productos Producto[]
}

model ImagenCategoria {
  id          String    @id @default(cuid())
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  url         String
  esPortada   Boolean   @default(false)
  orden       Int       @default(0)
}

model Producto {
  id          String         @id @default(cuid())
  nombre      String
  slug        String         @unique
  descripcion String?
  precio      Decimal        @db.Decimal(10, 2)
  estado      EstadoProducto @default(ACTIVO)
  destacado   Boolean        @default(false)

  // --- DESCUENTOS (Campos de caché para rendimiento en tienda) ---
  descuentoActivo Boolean                @default(false)
  descuentoTipo   TipoDescuentoProducto?
  descuentoValor  Decimal?               @db.Decimal(10, 2)
  descuentoInicio DateTime?
  descuentoFin    DateTime?
  // Nota: Eliminamos la relación compleja 'descuentoActual' para simplificar. 
  // La verdad del descuento vive en estos campos planos o en la consulta de campañas activas.

  // --- RELACIONES ---
  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  // Relación inversa con los detalles de campañas
  participacionesCampana DescuentoProducto[]

  imagenes      ImagenProducto[]
  variantes     Variante[]
  imagenesColor ImagenProductoColor[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  nuevoHasta    DateTime?
}

model Campana {
  id          String                  @id @default(cuid())
  nombre      String
  descripcion String?
  
  tipo        TipoDescuentoProducto
  valor       Decimal                 @db.Decimal(10, 2)
  
  startsAt    DateTime
  endsAt      DateTime
  
  estado      EstadoDescuentoProducto @default(PROGRAMADO)
  
  // Relación con los productos (Detalle)
  detalles    DescuentoProducto[]

  // Relación con Usuario (Creador)
  creadorId   String?
  creador     Usuario? @relation("CampanaCreadaPor", fields: [creadorId], references: [id])

  imagenUrl     String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model DescuentoProducto {
  id          String   @id @default(cuid())
  
  // 1. Vinculación con la Campaña (Padre)
  campanaId   String
  campana     Campana  @relation(fields: [campanaId], references: [id], onDelete: Cascade)

  // 2. Vinculación con el Producto (Hijo)
  productoId  String
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  
  // Un producto solo puede estar una vez en la misma campaña
  @@unique([campanaId, productoId])
  
  @@index([campanaId])
  @@index([productoId])
}

model ImagenProducto {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  url       String
  esPortada Boolean @default(false)
  orden     Int     @default(0)
}

model ImagenProductoColor {
  id String @id @default(cuid())

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  colorId String
  color   Color  @relation(fields: [colorId], references: [id])

  url           String
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([productoId, colorId])
}

model Talla {
  id        String     @id @default(cuid())
  nombre    String     @unique
  orden     Int        @default(0)
  variantes Variante[]
}

model Color {
  id        String     @id @default(cuid())
  nombre    String     @unique
  hex       String?
  activo    Boolean    @default(true)
  variantes Variante[]

  imagenesProducto ImagenProductoColor[]
}

model Variante {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  tallaId String
  talla   Talla  @relation(fields: [tallaId], references: [id])

  colorId String
  color   Color  @relation(fields: [colorId], references: [id])

  sku    String? @unique
  activa Boolean @default(true)

  stockActual Int @default(0)
  stockMinimo Int @default(4)

  movimientos MovimientoInventario[]
  itemsCompra ItemCompra[]
  itemsVenta  ItemVenta[]
  devoluciones DevolucionItem[]

  @@unique([productoId, tallaId, colorId])
}

model MovimientoInventario {
  id         String   @id @default(cuid())
  varianteId String
  variante   Variante @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  tipo           TipoMovimientoInventario
  cambioCantidad Int
  costoUnitario  Decimal?                 @db.Decimal(10, 2)
  nota           String?

  compraId String?
  compra   Compra? @relation(fields: [compraId], references: [id])
  ventaId  String?
  venta    Venta?  @relation(fields: [ventaId], references: [id])
  creadoEn DateTime @default(now())
}

model Proveedor {
  id            String   @id @default(cuid())
  nombre        String
  telefono      String?
  correo        String?
  ruc           String?
  razonSocial   String?
  departamento  String?
  provincia     String?
  distrito      String?
  direccion     String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  compras Compra[]
}

model Compra {
  id          String     @id @default(cuid())
  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  estado      EstadoCompra @default(BORRADOR)
  fechaCompra DateTime     @default(now())

  costoEnvio  Decimal? @db.Decimal(10, 2)
  otrosCostos Decimal? @db.Decimal(10, 2)
  notas       String?

  items       ItemCompra[]
  movimientos MovimientoInventario[]
  devoluciones Devolucion[]
  creadoEn    DateTime               @default(now())
}

model ItemCompra {
  id       String @id @default(cuid())
  compraId String
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  varianteId String?
  variante   Variante? @relation(fields: [varianteId], references: [id])

  tipoEmpaqueId String?
  tipoEmpaque   TipoEmpaque? @relation(fields: [tipoEmpaqueId], references: [id])

  cantidad      Int
  costoUnitario Decimal @db.Decimal(10, 2)
}

model Venta {
  id     String @id @default(cuid())
  codigo String @unique @default(cuid())

  clienteId     String?
  cliente       Cliente? @relation(fields: [clienteId], references: [id])
  clienteNombre String?

  canal      String      @default("WhatsApp")
  metodoPago MetodoPago  @default(YAPE)
  estado     EstadoVenta @default(COMPLETADO)

  subtotal       Decimal @default(0) @db.Decimal(10, 2)
  descuentoTotal Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @default(0) @db.Decimal(10, 2)

  notas      String?
  fechaVenta DateTime @default(now())

  items    ItemVenta[]
  empaques UsoEmpaque[]

  movimientos   MovimientoInventario[]
  devoluciones Devolucion[]
  creadoEn      DateTime               @default(now())
  actualizadoEn DateTime               @updatedAt
}

model ItemVenta {
  id      String @id @default(cuid())
  ventaId String
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  varianteId String
  variante   Variante @relation(fields: [varianteId], references: [id])

  cantidad Int

  precioUnitario Decimal @db.Decimal(10, 2)
  precioFinal    Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  tieneDescuento Boolean @default(false)
  descuentoMonto Decimal @default(0) @db.Decimal(10, 2)
  descuentoRazon String?
}

model TipoEmpaque {
  id            String  @id @default(cuid())
  nombre        String  @unique
  costoUnitario Decimal @db.Decimal(10, 2)
  activo        Boolean @default(true)
  imagenUrl     String?
  stock         Int     @default(0)

  usos        UsoEmpaque[]
  itemsCompra ItemCompra[]
}

model UsoEmpaque {
  id            String      @id @default(cuid())
  ventaId       String
  venta         Venta       @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  tipoEmpaqueId String
  tipoEmpaque   TipoEmpaque @relation(fields: [tipoEmpaqueId], references: [id])
  cantidad      Int
  costoTotal    Decimal     @db.Decimal(10, 2)
  creadoEn      DateTime    @default(now())
}

model Cliente {
  id           String  @id @default(cuid())
  nombre       String
  dni          String? @unique
  telefono     String?
  email        String?
  departamento String?
  provincia    String?
  distrito     String?
  direccion    String?
  referencia   String?
  saldoAFavor  Decimal  @default(0)

  ventas        Venta[]
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model Devolucion {
  id          String           @id @default(cuid())
  tipo        TipoDevolucion
  accion      AccionDevolucion
  motivo      String
  
  ventaId     String?
  venta       Venta?           @relation(fields: [ventaId], references: [id])
  
  compraId    String?
  compra      Compra?          @relation(fields: [compraId], references: [id])

  items       DevolucionItem[]
  
  montoTotal  Decimal          @default(0)
  creadoEn    DateTime         @default(now())
}

model DevolucionItem {
  id            String     @id @default(cuid())
  devolucionId  String
  devolucion    Devolucion @relation(fields: [devolucionId], references: [id])
  
  varianteId    String
  variante      Variante   @relation(fields: [varianteId], references: [id])
  
  cantidad      Int
}

model HeroBanner {
  id          String   @id @default(cuid())
  imagenUrl   String  
  titulo      String?  
  subtitulo   String?  
  botonTexto  String?  @default("Ver Colección")
  enlace      String?  
  orden       Int      @default(0) 
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model StoreSettings {
  id              String   @id @default("default")
  storeName       String
  tagline         String?
  description     String?

  logoUrl         String?
  faviconUrl      String?
  ogImageUrl      String?

  primaryColor    String?
  accentColor     String?
  backgroundColor String?

  fontHeading     String?
  fontBody        String?

  contactEmail    String?
  phone           String?
  whatsapp        String?
  address         String?

  currency        String   @default("PEN")
  locale          String   @default("es-PE")

  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt
}

model HomeSection {
  id            String          @id @default(cuid())
  type          TipoSeccionHome
  enabled       Boolean         @default(true)
  order         Int             @default(0)
  content       Json

  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt

  @@index([order])
  @@index([enabled])
  @@index([type])
}

model NavigationItem {
  id            String               @id @default(cuid())
  location      UbicacionNavegacion  @default(HEADER)
  label         String
  href          String
  order         Int                  @default(0)
  enabled       Boolean              @default(true)

  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt

  @@index([location, order])
  @@index([enabled])
}

model SocialLink {
  id            String   @id @default(cuid())
  platform      String
  url           String
  order         Int      @default(0)
  enabled       Boolean  @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([order])
  @@index([enabled])
}
